# Auto detect text files and perform LF normalization
* text=auto

# Go files
*.go text eol=lf

# Frontend files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Makefiles
Makefile text eol=lf
*.mk text eol=lf

# Documents
*.md diff=markdown

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.rar binary

# Fonts
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
