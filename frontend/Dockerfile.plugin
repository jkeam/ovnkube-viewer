# Build stage
FROM registry.redhat.io/ubi9/nodejs-24:9.8-1793067767 AS builder

# Set working directory
WORKDIR /opt/app-root/src

# Copy package files (including package-lock.json for reproducible builds)
COPY package.json package-lock.json ./

# Install dependencies with clean install
RUN npm ci

# Copy source code
COPY . .

# Build the console plugin
RUN npm run build:plugin

# Runtime stage - use UBI9 nginx for serving plugin
FROM registry.redhat.io/ubi9/nginx-126:9.8-1793065662

# Copy custom nginx configuration for console plugin
COPY nginx.plugin.conf /etc/nginx/nginx.conf

# Copy plugin artifacts
COPY --from=builder /opt/app-root/src/dist/plugin /opt/app-root/src

# Run as non-root user (nginx user)
USER 1001

# Expose plugin port (standard for console plugins)
EXPOSE 9443

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
