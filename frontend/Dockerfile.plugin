# Build stage
FROM registry.access.redhat.com/ubi9/nodejs-24:9.9-1795268857 AS builder

# Set working directory
WORKDIR /opt/app-root/src

# Copy package files (including package-lock.json for reproducible builds)
COPY package.json package-lock.json ./

# Install dependencies with clean install
RUN npm ci

# Copy source code
COPY . .

# Build the console plugin
RUN npm run build:plugin

# Runtime stage - use UBI9 nginx for serving plugin
FROM registry.access.redhat.com/ubi9/nginx-126:9.9-1795267041

# Copy plugin artifacts
COPY --from=builder /opt/app-root/src/dist/plugin /opt/app-root/src

# Create nginx config directory and copy custom server configuration
RUN mkdir -p /opt/app-root/etc/nginx.d
COPY nginx.plugin.server.conf /opt/app-root/etc/nginx.d/plugin.conf

# Run as non-root user (nginx user)
USER 1001

# Expose plugin port (standard for console plugins)
EXPOSE 9443

# Run nginx
CMD ["nginx", "-g", "daemon off;"]
